rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['employee_no']) &&
             data.employee_no is string &&
             (data.get('employee_name', '') is string);
    }

    function isHSEAdmin() {
      return true; 
    }

    match /hse_employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidId(employeeId) && isValidEmployee(incoming());
      allow delete: if isValidId(employeeId);
    }

    match /management_profiles/{uid} {
      allow read: if true;
      allow list: if true;
      allow create, update: if isValidId(uid) && (incoming().uid == uid);
      allow delete: if false;
    }

    match /imported_data/{docId} {
      allow read, write: if true;
    }

    match /hse_projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
