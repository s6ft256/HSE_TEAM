rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['employee_no', 'employee_name']) &&
             data.employee_no is string && data.employee_no.size() <= 50 &&
             data.employee_name is string && data.employee_name.size() <= 200 &&
             (data.get('department', '') is string) &&
             (data.get('designation', '') is string) &&
             (data.get('employee_no', '').matches('^[a-zA-Z0-9_\\-]+$'));
    }

  function isHSEAdmin() {
    return isSignedIn() && (
      request.auth.token.email == 'ahmed.abbas@trojanholding.com' ||
      request.auth.token.email == 'amal.j@npc.ae' ||
      request.auth.token.email == 'irshad.syed@npc.ae' ||
      request.auth.token.email == 'vidyaasree.v@trojan.ae' ||
      request.auth.token.email == 'alshifa.s@trojan.ae' ||
      request.auth.token.email == 'alejandro.l@trojan.ae' ||
      request.auth.token.email == 'm.shahbaz@trojan.ae' ||
      request.auth.token.email == 'm.razal@trojan.ae' ||
      request.auth.token.email == 'elius.n@trojan.ae' ||
      request.auth.token.email == 'niwamanyaelius95@gmail.com'
    );
  }

  function isValidManagementProfile(data) {
    return data.keys().hasAll(['uid', 'email']) &&
           data.uid == request.auth.uid &&
           data.email is string &&
           (data.get('fullName', '') is string) &&
           (data.get('phoneNumber', '') is string) &&
           (data.get('role', '') is string) &&
           (data.get('department', '') is string) &&
           (data.get('officeLocation', '') is string) &&
           (data.get('photoUrl', '') is string);
  }

  match /hse_employees/{employeeId} {
    allow read: if true;
    allow write: if isHSEAdmin(); 
  }

  match /management_profiles/{uid} {
    allow read: if isSignedIn() && request.auth.uid == uid;
    allow create, update: if isSignedIn() && request.auth.uid == uid && isValidManagementProfile(incoming());
    allow delete: if false;
  }

  match /hse_projects/{projectId} {
    allow read: if true;
    allow write: if isHSEAdmin();
  }

  match /hse_leadership/{leadershipId} {
    allow read: if true;
    allow write: if isHSEAdmin();
  }
  }
}
