rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['employee_no', 'employee_name']) &&
             data.employee_no is string && data.employee_no.size() <= 50 &&
             data.employee_name is string && data.employee_name.size() <= 200 &&
             (data.get('department', '') is string) &&
             (data.get('designation', '') is string) &&
             (data.get('employee_no', '').matches('^[a-zA-Z0-9_\\-]+$'));
    }

    function isHSEAdmin() {
      // Since Google Auth is removed as per user request, we have no secure way to verify admin on server
      // We allow writes for now to keep the app functional, but this is INSECURE.
      return true; 
    }

  function isValidManagementProfile(data) {
    return data.keys().hasAll(['uid', 'email']) &&
           data.email is string &&
           (data.get('fullName', '') is string) &&
           (data.get('phoneNumber', '') is string) &&
           (data.get('role', '') is string) &&
           (data.get('department', '') is string) &&
           (data.get('officeLocation', '') is string) &&
           (data.get('photoUrl', '') is string);
  }

  match /hse_employees/{employeeId} {
    allow read: if true;
    allow create, update: if isValidId(employeeId) && isValidEmployee(incoming());
    allow delete: if isValidId(employeeId);
  }

  match /management_profiles/{uid} {
    allow read: if true;
    allow list: if true;
    allow create, update: if isValidManagementProfile(incoming());
    allow delete: if false;
  }

  match /hse_projects/{projectId} {
    allow read: if true;
    allow write: if isHSEAdmin();
  }
  }
}
