{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "HSE Employee record",
      "type": "object",
      "properties": {
        "sn": { "type": "number" },
        "level": { "type": "string" },
        "employee_no": { "type": "string" },
        "employee_name": { "type": "string" },
        "department": { "type": "string" },
        "recommended_for": { "type": "string" },
        "date_of_joining": { "type": "string", "format": "date" },
        "designation": { "type": "string" },
        "gender": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "qualification": { "type": "string" },
        "nationality": { "type": "string" },
        "kpi": { "type": "number" },
        "project": { "type": "string" },
        "line_manager": { "type": "string" },
        "area_manager": { "type": "string" },
        "bu_manager": { "type": "string" }
      },
      "required": ["employee_no", "employee_name"]
    },
    "ManagementProfile": {
      "title": "Management Profile",
      "description": "Profile information for management users",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phoneNumber": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "officeLocation": { "type": "string" },
        "photoUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Leadership": {
      "title": "Leadership",
      "description": "HSE Leadership team members",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" }
      }
    }
  },
  "firestore": {
    "hse_employees": {
      "schema": "Employee",
      "description": "Collection of HSE employees"
    },
    "management_profiles": {
      "schema": "ManagementProfile",
      "description": "User profiles for managers"
    },
    "hse_leadership": {
      "schema": "Leadership",
      "description": "HSE Leadership & Documentation team"
    }
  }
}
